{
  "name": "pasaulesture-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:i18n",
    "build": "next build",
    "build:i18n": "paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "start": "next start",
    "lint": "eslint",
    "machine-translate": "inlang machine translate --project project.inlang",
    "db:migrate": "node --env-file=.env.local scripts/run-migrations.js",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.2.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.8.0",
    "@inlang/plugin-m-function-matcher": "^2.1.2",
    "@inlang/plugin-message-format": "^4.2.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
